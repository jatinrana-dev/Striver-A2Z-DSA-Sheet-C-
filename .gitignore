# 1. Ignore everything inside any folder or subfolder
/*
!/*/

# 2. Re-include all directories so Git can traverse subfolders
!/**/

# 3. Re-include source files, headers, and docs anywhere in the repo
!*.cpp
!*.hpp
!*.c
!*.h
!*.md
!.gitignore

# 4. Explicitly ignore compiled binary/build extensions anywhere
*.o
*.out
*.exe
*.dSYM/
.DS_Store